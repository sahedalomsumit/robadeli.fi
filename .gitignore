# ============================================================
# Roba Deli — .gitignore
# ============================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/

# Environment & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Lock files (keep package-lock.json, ignore others)
yarn.lock
pnpm-lock.yaml

# Editor directories
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Cache
.cache/
.eslintcache
.parcelcache
.vite/

# Vite
*.local

# Testing
coverage/

# Temporary files
*.tmp
*.temp
